<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Enable cleartext traffic globally for local POS HTTP integration (dynamic LAN IPs) -->
    <base-config cleartextTrafficPermitted="true" />

    <!-- Permit cleartext traffic for local business, management, and testing endpoints -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.220.172.15</domain>
        <domain includeSubdomains="true">192.168.1.100</domain>
        <domain includeSubdomains="true">192.168.1.200</domain>
    </domain-config>
</network-security-config>
